# Long-Running Agent Harness — gitignore

# --- Python artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# --- Node artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.nuxt/
coverage/

# --- TypeScript build output under package sources ---
# Source trees (packages/*/src/) should only contain .ts files.
# tsc with `noEmit: true` won't produce these, but a stray tsc
# invocation with the wrong flags will. Keep src/ TS-only.
packages/*/src/*.js
packages/*/src/*.js.map
*.tsbuildinfo

# --- Secrets and environment files ---
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx
secrets/
secrets.yaml
secrets.yml
credentials.json

# --- IDE and editor artifacts ---
.idea/
.vscode/launch.json
.vscode/*.log
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Logs and temp files ---
*.log
logs/
tmp/
.cache/

# --- Lock sentinels ---
# file_lock writes sibling <name>.lock files next to its targets
# (feature_list.json -> feature_list.json.lock, etc.). They are
# recreated on every mutating run and are safe to delete at any time.
*.lock

# --- Test harness artifacts ---
# Per-run test workspace directories produced by the daemon's
# restart-resilience tests (e.g. `heddle_rts_<token>/`). Each test
# creates one in tmp_path; if a test crashes mid-run the dir is
# left behind. They are not part of the source tree and have no
# value at HEAD or in CI.
packages/node/heddle_rts_*/

# --- Allow tracked recommendations and placeholders ---
!.gitkeep
!.vscode/extensions.json
!.vscode/settings.json